---
layout: layouts/base.njk
title: "LUMÉA — Digital Invitations & Menus"
description: "Invitations et menus digitaux élégants pour mariages, anniversaires, naissances et restaurants. Votre moment, beautifully designed."
bodyClass: "page-landing"
---
{% from "partials/logo.njk" import mark, symbol, wordmark %}
{% from "partials/icons.njk" import icon %}

<header class="site-header">
  {{ mark() }}
  <nav class="site-nav">
    <span class="site-langs"><a href="/modeles/" lang="fr">FR</a> · <a href="/en/templates/" lang="en">EN</a> · <a href="/ar/templates/" lang="ar">ع</a></span>
    <a href="/modeles/" class="btn btn-ghost">Nos modèles</a>
  </nav>
</header>

<section class="hero">
  <div class="hero-inner">
    <h1 class="hero-wordmark">{{ wordmark() }}</h1>
    <p class="hero-tagline">Digital Invitations &amp; Menus</p>
    <p class="hero-signature">Your moment, beautifully designed.</p>
    <div class="btn-row center">
      <a href="/modeles/" class="btn btn-ghost">Voir les modèles en direct</a>
      <a href="#pricing" class="btn btn-primary">Créer votre invitation</a>
    </div>
  </div>
</section>

<section id="collections" class="section">
  <div class="container">
    <div class="section-head center">
      <span class="label">Collections</span>
      <h2>Une création pour chaque moment</h2>
    </div>
    <div class="grid grid-5 reveal">
      {# Counts come from the catalogue (src/_data/templates.json) #}
      {% set cards = [
        { name: "Mariage", count: templates | where("occasion", "wedding") | length, href: "/modeles/#wedding" },
        { name: "Fiançailles & Henné", count: (templates | where("occasion", "engagement") | length) + (templates | where("occasion", "henna") | length), href: "/modeles/" },
        { name: "Anniversaire", count: templates | where("occasion", "birthday") | length, href: "/modeles/#birthday" },
        { name: "Menus digitaux", count: collections.menus.length, href: "/menus/" + collections.menus[0].slug + "/" },
        { name: "Sur-mesure", desc: "Votre idée", href: site.whatsapp }
      ] %}
      {% for c in cards %}
      <a class="collection-card" href="{{ c.href }}">
        <div>
          <span class="label">{{ c.desc or (c.count + (" modèles" if c.count > 1 else " modèle")) }}</span>
          <h3>{{ c.name }}</h3>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section-head center">
      <span class="label">Showcase</span>
      <h2>Nos créations, en situation</h2>
    </div>
    <div class="showcase-track reveal">
      {# Every example invitation, framed in its theme's colours: [from, to, ink] #}
      {% set frames = {
        "minimal-wedding": ["#fbf8f3", "#efe7db", "#2a2520"],
        "oriental-luxury": ["#2a1f16", "#120e0b", "#d4b273"],
        "modern-wedding": ["#1a1a1a", "#070707", "#ffffff"],
        "tunisian-heritage": ["#dcecf4", "#ffffff", "#1b3a4b"],
        "floral": ["#fdf6f3", "#f3e1db", "#4a3532"],
        "celestial-night": ["#1d2a5c", "#060918", "#e3cf9a"],
        "henna-night": ["#5a1f28", "#180609", "#e0b25c"],
        "andalusian-riad": ["#fbf1e3", "#e6c7a5", "#1f6f78"],
        "boho-countryside": ["#f6d7b8", "#efe1cf", "#4a3326"],
        "birthday-party": ["#fff7ec", "#f9cfbf", "#3a2440"]
      } %}
      {% for inv in collections.invitations %}
      {% set f = frames[inv.theme] or frames["minimal-wedding"] %}
      <a class="phone" href="/invitations/{{ inv.slug }}/">
        <div class="phone-frame" style="background: linear-gradient(170deg, {{ f[0] }}, {{ f[1] }}); color: {{ f[2] }};">
          {% if inv.couple %}
          <p class="phone-names">{{ inv.couple.name1 }} <i>&amp;</i> {{ inv.couple.name2 }}</p>
          {% else %}
          <p class="phone-names">{{ inv.honoree.name }} <i>{{ inv.honoree.age }}</i></p>
          {% endif %}
        </div>
        <p class="phone-caption">{{ inv.eventType or "Mariage" }} — {% if inv.couple %}{{ inv.couple.name1 }} &amp; {{ inv.couple.name2 }}{% else %}{{ inv.honoree.name }}{% endif %}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head center">
      <span class="label">Comment ça marche</span>
      <h2>De l'idée au lien partagé, en 5 étapes</h2>
    </div>
    <div class="steps reveal">
      {% set steps = [
        "Choisissez votre design",
        "Envoyez vos informations",
        "Nous créons votre invitation",
        "Recevez votre lien",
        "Partagez-le avec vos invités"
      ] %}
      {% for s in steps %}
      <div class="step">
        <div class="step-number">0{{ loop.index }}</div>
        <h3>{{ s }}</h3>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section-head center">
      <span class="label">Features</span>
      <h2>Tout ce qu'il faut, rien de superflu</h2>
    </div>
    <div class="grid grid-3 reveal">
      {% set features = [
        { icon: "responsive", label: "Design responsive" },
        { icon: "qrcode", label: "QR Code" },
        { icon: "map-pin", label: "Google Maps" },
        { icon: "countdown", label: "Countdown" },
        { icon: "gallery", label: "Galerie photos" },
        { icon: "rsvp", label: "RSVP" },
        { icon: "program", label: "Programme" },
        { icon: "animations", label: "Animations" },
        { icon: "music", label: "Musique optionnelle" },
        { icon: "whatsapp", label: "Partage WhatsApp" },
        { icon: "responsive", label: "Français, anglais ou arabe" },
        { icon: "program", label: "Version imprimable offerte" }
      ] %}
      {% for f in features %}
      <div class="feature">
        {{ icon(f.icon) }}
        <span>{{ f.label }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="pricing" class="section">
  <div class="container">
    <div class="section-head center">
      <span class="label">Pricing</span>
      <h2>Un prix simple, payé une seule fois</h2>
      <p style="color:var(--text-muted);">Chaque modèle s'achète une fois, sans abonnement. La version statique est offerte.</p>
    </div>
    <div class="pricing-grid reveal">
      <div class="card pricing-card">
        <span class="label">Essentiel</span>
        <p class="price">39,999 <span>DT</span></p>
        <p>Épure, Heure Dorée, Livre de Fleurs, Confettis</p>
        <ul class="pricing-features">
          <li>{{ icon("check") }} Film d'ouverture animé</li>
          <li>{{ icon("check") }} Date, lieu, compte à rebours, RSVP</li>
          <li>{{ icon("check") }} Français, anglais ou arabe</li>
          <li>{{ icon("check") }} Version statique offerte</li>
        </ul>
        <a href="/modeles/" class="btn btn-ghost">Voir les modèles</a>
      </div>
      <div class="card pricing-card featured">
        <span class="pricing-badge">Le plus populaire</span>
        <span class="label">Premium</span>
        <p class="price">45,999 <span>DT</span></p>
        <p>Palais d'Orient, Porte Bleue, Nuit Étoilée, Riad Andalou, Première Danse, L'Écrin, Nuit du Henné</p>
        <ul class="pricing-features">
          <li>{{ icon("check") }} Tout Essentiel</li>
          <li>{{ icon("check") }} Ouvertures signature (écrin, porte, livre…)</li>
          <li>{{ icon("check") }} Galerie photos, programme, itinéraire</li>
          <li>{{ icon("check") }} Version statique offerte</li>
        </ul>
        <a href="/modeles/" class="btn btn-primary">Choisir un modèle</a>
      </div>
      <div class="card pricing-card">
        <span class="label">Sur-mesure</span>
        <p class="price">Sur devis</p>
        <p>Une invitation créée de zéro, à vos couleurs</p>
        <ul class="pricing-features">
          <li>{{ icon("check") }} Design 100% sur-mesure</li>
          <li>{{ icon("check") }} Animations personnalisées</li>
          <li>{{ icon("check") }} Musique de fond optionnelle</li>
          <li>{{ icon("check") }} Accompagnement jusqu'au jour J</li>
        </ul>
        <a href="{{ site.whatsapp }}?text={{ 'Bonjour LUMÉA, je souhaite une invitation sur-mesure.' | urlencode }}" class="btn btn-ghost" target="_blank" rel="noopener">Demander un devis</a>
      </div>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section-head center">
      <span class="label">FAQ</span>
      <h2>Questions fréquentes</h2>
    </div>
    <div class="reveal" style="max-width:640px;margin-inline:auto;">
      {% set faqs = [
        { q: "Combien de temps pour recevoir mon invitation digitale ?", a: "48 à 72h après réception de vos informations." },
        { q: "Combien coûte une invitation ?", a: "39,999 DT ou 45,999 DT selon le modèle, en achat unique, sans abonnement. La version statique est offerte." },
        { q: "Comment mes invités reçoivent-ils l'invitation ?", a: "Un lien unique à partager par WhatsApp, SMS ou réseaux sociaux — aucune application à installer." },
        { q: "Le RSVP fonctionne-t-il sans compte ?", a: "Oui, un formulaire simple relié à votre email ou WhatsApp." },
        { q: "Proposez-vous des menus pour restaurants seuls ?", a: "Oui, c'est un service indépendant, sans lien avec un mariage." },
        { q: "Puis-je garder mon invitation en ligne après l'événement ?", a: "Oui, le lien reste actif, comme un souvenir." },
        { q: "Mon invitation peut-elle être en arabe ou en anglais ?", a: "Oui. Chaque invitation existe en français, en anglais et en arabe (lecture de droite à gauche), et vos invités passent d'une langue à l'autre en un geste." },
        { q: "Ai-je aussi une version à imprimer ou à poster en statut ?", a: "Oui, offerte avec chaque modèle : une carte au format 9:16 avec un QR code vers l'invitation animée, à télécharger en PDF." }
      ] %}
      {% for f in faqs %}
      <details class="faq-item">
        <summary class="faq-q">{{ f.q }} {{ icon("chevron") }}</summary>
        <p class="faq-a">{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="container cta-final">
    <h2>Prêt à créer votre moment ?</h2>
    <div class="btn-row center" style="justify-content:center;">
      <a href="/modeles/" class="btn btn-ghost">Voir les modèles</a>
      <a href="{{ site.whatsapp }}?text={{ 'Bonjour LUMÉA, je souhaite créer mon invitation.' | urlencode }}" class="btn btn-primary" target="_blank" rel="noopener">Créer votre invitation</a>
    </div>
  </div>
</section>

<footer class="section--dark site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        {{ mark() }}
        <p style="margin-top:var(--space-2);opacity:0.75;max-width:280px;">{{ site.tagline }}</p>
      </div>
      <div>
        <h4>Navigation</h4>
        <a href="/modeles/">Modèles</a>
        <a href="#collections">Collections</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </div>
      <div>
        <h4>Collections</h4>
        <a href="/modeles/#wedding">Mariage</a>
        <a href="/modeles/#birthday">Anniversaire</a>
        <a href="/en/templates/">English</a>
        <a href="/ar/templates/">العربية</a>
      </div>
      <div>
        <h4>Contact</h4>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <div class="social-row" style="margin-top:var(--space-2);">
          <a href="{{ site.instagram }}" aria-label="Instagram">{{ icon("instagram") }}</a>
          <a href="{{ site.facebook }}" aria-label="Facebook">{{ icon("facebook") }}</a>
          <a href="{{ site.whatsapp }}" aria-label="WhatsApp">{{ icon("whatsapp") }}</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ year }} LUMÉA. Tous droits réservés.</span>
      <span>Tunis, Tunisie</span>
    </div>
  </div>
</footer>
